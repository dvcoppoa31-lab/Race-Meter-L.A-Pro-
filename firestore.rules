rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.username is string && data.username.size() > 0 &&
             data.password is string && data.password.size() >= 4 &&
             data.role in ['owner', 'admin', 'customer'];
    }

    function isValidRun(data) {
      return data.id is string && data.date is number &&
             data.totalDistance is number && data.totalTime is number &&
             data.maxSpeed is number &&
             data.splits is list && data.telemetry is list;
    }

    // Connection test doc
    match /test/connection {
      allow get: if true;
    }

    // System configuration (Broadcast, Config)
    match /system/{configItem} {
      allow read: if true;
      allow write: if true;
    }

    // Audit Logs
    match /system_logs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // User Profile Rules
    match /users/{username} {
      // For this custom login system, we allow getting a specific user profile to check password
      allow get, delete: if isValidId(username);
      
      // Allow creating a new account (signup)
      allow create: if isValidId(username) && isValidUser(request.resource.data);
      
      // Allow updating profile
      allow update: if isValidId(username) && isValidUser(request.resource.data);

      // Admins can list all users
      allow list: if true;

      // History / Runs Rules
      match /runs/{runId} {
        allow read, write, delete: if isValidId(username) && isValidId(runId);
        allow list: if isValidId(username);
      }
    }

    // Collection Group Access for Global Stats
    match /{path=**}/runs/{runId} {
      allow read: if true; // In a real app, restrict to admins
    }
  }
}
